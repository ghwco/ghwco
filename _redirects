# Old Squarespace URLs -> new pages. 301 = permanent, which passes existing
# search ranking through to the new address.
#
# DO NOT add rules like "/services -> /services.html" here.
# Cloudflare Pages serves clean URLs natively: it already answers /services
# with services.html, and it 308-redirects /services.html -> /services. A rule
# pointing /services back at /services.html creates an infinite redirect loop,
# which is exactly what broke every nav link on the first deploy.
#
# Only list paths whose destination is a DIFFERENT page.

/appointments          /#book                     301
/appointments/         /#book                     301
/book                  /#book                     301
/booking               /#book                     301
/schedule              /#book                     301
/cart                  /                          301
/insurance             /faq#insurance             301
/insurance/            /faq#insurance             301
/journal               /blog                      301
/our-team              /team                      301
/emdr                  /trauma-emdr               301
/trauma                /trauma-emdr               301
/groups                /mamas-golden-hour         301
/group-therapy         /mamas-golden-hour         301
/mamas-golden-hour-group  /mamas-golden-hour      301

# No catch-all. Cloudflare Pages serves 404.html for unmatched paths on its
# own; a "/* -> /404.html" rule here intercepts real pages before they resolve.
